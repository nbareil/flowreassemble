from os import PathLike

class PcapError(Exception): ...

class Handle:
    def set_snaplen(self, snaplen: int) -> None: ...
    def set_promisc(self, promisc: bool) -> None: ...
    def set_timeout(self, timeout_ms: int) -> None: ...
    def set_immediate_mode(self, immediate: bool) -> None: ...
    def set_buffer_size(self, size: int) -> None: ...
    def set_rfmon(self, rfmon: bool) -> None: ...
    def set_tstamp_precision(self, precision: str) -> None: ...
    def activate(self) -> None: ...
    def setfilter(self, expression: str, optimize: bool = True) -> None: ...
    def datalink(self) -> int: ...
    def breakloop(self) -> None: ...
    def close(self) -> None: ...

def open_offline(path: str | PathLike[str]) -> Handle: ...
def open_live(device: str, snaplen: int, promisc: bool, timeout_ms: int) -> Handle: ...
def create(device: str) -> Handle: ...
def findalldevs() -> list[str]: ...

class Reassembler:
    def __init__(
        self,
        server: tuple[str, int | None] | None,
        idle_timeout: float | None,
        http: dict[str, object] | None = None,
    ) -> None: ...
    def push(self, ts: float, linktype: int, frame: bytes) -> list[tuple]: ...
    def finish(self) -> list[tuple]: ...
    def run(self, handle: Handle) -> list[tuple] | None: ...
